# Evidence Studio — 사내 서비스 연결
# 이 파일을 .env로 복사해 사내 값을 입력하세요. .env는 Git에서 제외합니다.
# 변경 후 서버 재시작. 시스템 환경변수가 우선하며 키는 backend에서만 읽습니다.

# 로그인: local_admin에서는 아래 사번으로 임시 관리자 자동 접속.
# 실제 사번은 이 파일에 적지 말고 복사한 .env에만 입력하세요.
# 비어 있으면 local_admin에서만 데모 ID 0000000 사용. sso에서는 실제 사번 필수.
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
# 사내 이관 시 backend/sso_adapter.py의 두 함수를 구현한 후 sso로 변경하세요.
# sso 모드의 미설정·실패는 접속을 차단하며 임시 관리자로 우회하지 않습니다.
AUTH_MODE=local_admin
SSO_COOKIE_NAME=
# SSO 인증/프로필 API URL·키는 실제 계약 확정 후 backend에만 추가하세요.

# LLM: /v1 같은 기본 URL 또는 /chat/completions 전체 URL.
# Bearer 인증, messages 요청, choices[0].message.content 응답.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding: /embedding을 포함한 전체 호출 URL을 입력하세요. 그대로 POST합니다.
# 코드 기본값: Bearer 인증, {"input": text, "model": model}, data[0].embedding.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 사내 embedding 모델의 실제 입력 한도와 로컬 Hugging Face tokenizer.json 경로.
# 경로가 비어 있으면 비교용 tokenizer 사용. 실제 모델과 token 수가 같지는 않습니다.
EMBEDDING_MAX_INPUT_TOKENS=512
CHUNK_TOKENIZER_PATH=

# Reranker: 별도 API key 없이 EMBEDDING_API_KEY를 재사용합니다.
RERANKER_BASE_URL=
RERANKER_MODEL=

# Embedding 미설정 시 구조 기반 분할, 설정 시 embedding 기반 문맥 분할.
# 인증·요청/응답·1건씩 전송·분할 임계값은 코드 기본값을 사용합니다.
# Wiki 갱신 작업은 앱 실행 중 백그라운드에서 처리합니다.
# 설정 후 첫 실행은 기존 지식의 LLM 종합과 검색 vector 색인을 생성할 수 있습니다.
# 연결 검사: python -m backend.reindex_search --check (테스트 문장만 전송)
# 기존 논문 적용: python -m backend.reindex_search (자동 백업 후 재색인)
# LLM 답변·Wiki 갱신·검색 연결은 구현되어 있습니다. 실제 사내 모델 검증은 필요합니다.
# Reranker는 전체 URL을 그대로 사용합니다. 기본 계약: {model,query,documents}
# 응답: results[{index,relevance_score}] 또는 [{index,score}]. 사내 형식과 대조하세요.
