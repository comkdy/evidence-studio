# Evidence Studio — 사내 연결 설정
# .env로 복사해 값을 입력하세요. 실제 .env는 Git에서 제외합니다.
# 시스템 환경변수 > .env > 코드 기본값. 변경 후 서버를 재시작하세요.

# 로그인: 실제 사번은 복사한 .env에만 입력하세요.
# 빈 값은 local_admin에서 데모 ID 0000000 사용. SSO에서는 실제 사번 필수.
# 사내 SSO 연결은 backend/sso_adapter.py 구현 후 AUTH_MODE=sso로 변경.
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
AUTH_MODE=local_admin
SSO_COOKIE_NAME=

# 두 LLM이 공유하는 연결. 기본 URL 또는 /chat/completions 전체 URL.
# Bearer 인증, messages 요청, choices[0].message.content 응답.
LLM_BASE_URL=
LLM_API_KEY=
LLM_BASE_MODEL=
# 선택: 원문 사실·인용 추출용 경량 모델. 비우면 기본 모델 사용.
LLM_LIGHT_MODEL=

# 실제 모델 규격에 맞출 context 한도(입력+출력)와 Wiki 출력 한도.
LLM_CONTEXT_TOKENS=16384
LLM_LIGHT_CONTEXT_TOKENS=16384
WIKI_OUTPUT_TOKENS=2048

# Embedding과 Reranker가 공유하는 전체 호출 URL. 둘 모두 이 URL에 POST.
# 경로를 자동 추가하거나 /embedding을 /rerank로 변경하지 않습니다.
# 두 서비스 모두 EMBEDDING_API_KEY로 Bearer 인증합니다.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANKER_MODEL=
EMBEDDING_MAX_INPUT_TOKENS=512

# 연결 계약·기존 .env 변경 방법·선택적인 고급 설정: docs/CONFIGURATION.md
# LLM 대기 기본 300초, 기본 공유 자원 그룹의 동시 호출 1개.
# tokenizer 파일은 선택 사항이며, API만으로도 사용할 수 있습니다.

# 선택: 답변/분석/검토 모델 구분. 비우면 LLM_BASE_MODEL을 사용합니다.
# 역할 모두 위 LLM_BASE_URL과 LLM_API_KEY를 공유합니다.
# LLM_ANSWER_MODEL=
# LLM_BACKGROUND_MODEL=
# LLM_REVIEW_MODEL=
# 실제 하드웨어가 분리되어 확인된 경우에만 RESOURCE_GROUP을 나눕니다.
# LLM_RESOURCE_GROUP=shared
# LLM_ANSWER_RESOURCE_GROUP=shared
# LLM_BACKGROUND_RESOURCE_GROUP=shared
# LLM_REVIEW_RESOURCE_GROUP=shared
# 동일 모델명으로 배포 버전이 바뀌면 revision도 변경하세요.
# LLM_DEPLOYMENT_REVISION=
# LLM_REVIEW_DEPLOYMENT_REVISION=
# 역할별 *_CONTEXT_TOKENS, *_TOKENIZER_PATH, *_MAX_OUTPUT_TOKENS도 선택 가능.
# PDF 등록은 모델 없이 검색부터 준비합니다. Wiki는 전문가/질문 수요로 구축합니다.
